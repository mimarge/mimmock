# ─────────────────────────────────────────────────────────────────────────────
# MimMock yapılandırması. Bu dosyayı `.env` adıyla kopyalayın:
#     cp .env.example .env        (ya da: ./scripts/mimmock init)
# `.env` depoya girmez ve imaja kopyalanmaz.
# ─────────────────────────────────────────────────────────────────────────────

# ── ZORUNLU: mimkit — TEK dış bağımlılık ─────────────────────────────────────
# XSD + şematron doğrulaması, seri numaralama ve HTML/PDF görüntü buradan gelir.
# mimkit'e ulaşılamazsa ya da anahtar reddedilirse MimMock KALKMAZ — sahte bir
# doğrulayıcı, üretimde reddedilecek belgeyi kabul ediyormuş gibi gösterirdi.
#
# 🔑 Adres ve anahtar için bilgi@mimsoft.com.tr adresine e-posta gönderin.
MIMMOCK_MIMKIT_URL=
MIMMOCK_MIMKIT_TOKEN=
# Seri numaralama kapsamı (boşsa gönderen şirketin VKN'si kullanılır).
MIMMOCK_MIMKIT_SCOPE_ID=

# mimkit OLMADAN kaldırmak için 1 yapın. Panel, şirketler, webhook, saat ve gelen
# kutusu enjeksiyonu çalışır; belge GÖNDERME ve görüntü uçları 503 döner.
MIMMOCK_ALLOW_OFFLINE=0

# ── İmaj sürümü ──────────────────────────────────────────────────────────────
# `latest` ya da sabit bir sürüm (ör. 0.1.0). Ekip ortak sandbox'ında sabitleyin.
MIMMOCK_VERSION=latest

# ── Ana makinede yayınlanan port ─────────────────────────────────────────────
# Container içinde her zaman 8088 dinlenir; bu, sizin makinenizdeki kapıdır.
MIMMOCK_HOST_PORT=8088

# ── Panel kapısı ─────────────────────────────────────────────────────────────
# Boşsa panel açık (yerel sandbox). Ekip ortak makinesinde bir değer verin.
MIMMOCK_PANEL_TOKEN=

# ── Trafik üreteci ───────────────────────────────────────────────────────────
# Tanımlı şirketlere dışarıdan gelmiş gibi GERÇEK fatura üretir (işaretli).
MIMMOCK_TRAFFIC_ENABLED=1
MIMMOCK_TRAFFIC_INTERVAL_MS=120000
MIMMOCK_TRAFFIC_BURST=1
MIMMOCK_TRAFFIC_SEED=mimmock

# ── Diğer ────────────────────────────────────────────────────────────────────
MIMMOCK_SEED=1
MIMMOCK_LOG_LEVEL=info
# Şema sürümü değiştiyse eski veriyi silip yeniden kur (yükseltmede kullanışlı).
MIMMOCK_DB_AUTO_RESET=0
# Dış PostgreSQL için (docker-compose.pg.yml bunu kendisi ayarlar):
# MIMMOCK_DB=postgres://kullanici:parola@host:5432/mimmock
